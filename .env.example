# ── ONE LLM credential for the entire organization ──────────────────────────
# Never put this value in frontend code, generated code, logs or the repository.
LLM_PROVIDER=openai-compatible
LLM_PROVIDER_API_KEY=replace-with-your-single-api-key
LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=gpt-4o
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=8
LLM_REQUESTS_PER_MINUTE=120
LLM_MAX_RETRIES=3
LLM_ENABLE_PROMPT_CACHE=true
LLM_ENABLE_RESULT_CACHE=true

# Use LLM_PROVIDER=mock only for offline development / automated tests.
# LLM_PROVIDER=mock

# ── Storage ──────────────────────────────────────────────────────────────────
# PostgreSQL is recommended in production:
# DATABASE_URL=postgresql+psycopg://aise:aise@localhost:5432/aise
DATABASE_URL=sqlite:///./data/aise.db
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ── Execution sandbox ────────────────────────────────────────────────────────
SANDBOX_MODE=auto                 # auto | docker | local
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_MEMORY_MB=1024
SANDBOX_CPU_QUOTA=1
COMMAND_TIMEOUT_SECONDS=120
MAX_COMMAND_OUTPUT_CHARS=40000
WORKSPACE_ROOT=./data/workspaces
PROJECT_CONCURRENCY=3
ENABLE_BROWSER=true

# ── Budgets and safety ───────────────────────────────────────────────────────
MAX_TOKENS_PER_TASK=24000
MAX_TOKENS_PER_AGENT_PER_PROJECT=120000
MAX_PROJECT_TOKENS=1000000
MAX_REVIEW_ITERATIONS=2
REQUIRE_DEPLOYMENT_APPROVAL=true
REQUIRE_ARCHITECTURE_APPROVAL=false
SECRETS_ENCRYPTION_KEY=           # Fernet key material; generate with scripts/gen_key.py

# ── API ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
